@model IEnumerable<HelpDesk.Api.Models.Ticket>

@{
    ViewData["Title"] = "Tickets List";
}

<div class="page-title-section">
    <div>
        <h1 class="page-title">Support Tickets</h1>
        <p class="text-muted">Manage and track company support requests.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom">
        ➕ Raise New Ticket
    </a>
</div>

<!-- Filtering Panel -->
<div class="glass-card mb-4">
    <form method="get" asp-action="Index" class="d-flex align-items-center gap-3 flex-wrap">
        <div class="d-flex align-items-center gap-2">
            <span style="font-weight: 600; color: #475569;">Filter Status:</span>
            <select name="statusFilter" id="statusFilter" class="form-control" style="width: 180px;" onchange="this.form.submit()">
                <option value="All" selected="@(ViewBag.CurrentFilter == "All" || string.IsNullOrEmpty(ViewBag.CurrentFilter))">All Statuses</option>
                <option value="Open" selected="@(ViewBag.CurrentFilter == "Open")">Open</option>
                <option value="In Progress" selected="@(ViewBag.CurrentFilter == "In Progress")">In Progress</option>
                <option value="Closed" selected="@(ViewBag.CurrentFilter == "Closed")">Closed</option>
            </select>
        </div>
        
        <!-- Optional helper info -->
        <span class="text-muted" style="font-size: 0.9rem;">
            Showing @Model.Count() ticket(s)
        </span>
    </form>
</div>

<!-- Tickets Table -->
<div class="table-responsive">
    <table class="table custom-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Raised By</th>
                <th>Created Date</th>
                <th class="text-center" style="width: 250px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center py-4 text-muted">
                        No tickets found matching the filter criteria.
                    </td>
                </tr>
            }
            else
            {
                foreach (var ticket in Model)
                {
                    <tr>
                        <td><strong>#@ticket.Id</strong></td>
                        <td>@ticket.Title</td>
                        <td>
                            @{
                                var priorityClass = ticket.Priority?.ToLower() switch
                                {
                                    "high" => "priority-high",
                                    "medium" => "priority-medium",
                                    "low" or _ => "priority-low"
                                };
                            }
                            <span class="badge-priority @priorityClass">@ticket.Priority</span>
                        </td>
                        <td>
                            @{
                                var statusClass = ticket.Status?.ToLower() switch
                                {
                                    "open" => "status-open",
                                    "in progress" => "status-inprogress",
                                    "closed" or _ => "status-closed"
                                };
                            }
                            <span class="badge-status @statusClass">@ticket.Status</span>
                        </td>
                        <td>@ticket.RaisedBy</td>
                        <td>@ticket.CreatedDate.ToString("g")</td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-secondary-custom" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
                                    Details
                                </a>
                                <a asp-action="Edit" asp-route-id="@ticket.Id" class="btn btn-sm btn-secondary-custom" style="padding: 0.35rem 0.75rem; font-size: 0.85rem; border-color: var(--accent-color); color: var(--accent-color);">
                                    Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@ticket.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this ticket?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger-custom" style="padding: 0.35rem 0.75rem; font-size: 0.85rem;">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
