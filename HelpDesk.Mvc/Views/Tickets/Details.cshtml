@model HelpDesk.Api.Models.Ticket

@{
    ViewData["Title"] = "Ticket Details";
}

<div class="mb-4">
    <h1 class="page-title">Ticket details</h1>
    <p class="text-muted">Viewing details for ticket #@Model.Id</p>
</div>

<div class="glass-card">
    <div class="details-grid">
        <div class="details-item">
            <div class="details-label">Ticket ID</div>
            <div class="details-value">#@Model.Id</div>
        </div>
        <div class="details-item">
            <div class="details-label">Raised By</div>
            <div class="details-value">@Model.RaisedBy</div>
        </div>
        <div class="details-item">
            <div class="details-label">Created Date</div>
            <div class="details-value">@Model.CreatedDate.ToString("g")</div>
        </div>
        <div class="details-item">
            <div class="details-label">Priority</div>
            <div class="details-value">
                @{
                    var priorityClass = Model.Priority?.ToLower() switch
                    {
                        "high" => "priority-high",
                        "medium" => "priority-medium",
                        "low" or _ => "priority-low"
                    };
                }
                <span class="badge-priority @priorityClass">@Model.Priority</span>
            </div>
        </div>
        <div class="details-item">
            <div class="details-label">Status</div>
            <div class="details-value">
                @{
                    var statusClass = Model.Status?.ToLower() switch
                    {
                        "open" => "status-open",
                        "in progress" => "status-inprogress",
                        "closed" or _ => "status-closed"
                    };
                }
                <span class="badge-status @statusClass">@Model.Status</span>
            </div>
        </div>
        <div class="details-desc">
            <div class="details-label">Title</div>
            <h4 class="mb-3" style="font-weight: 600;">@Model.Title</h4>
            
            <div class="details-label">Description</div>
            <p style="white-space: pre-wrap; font-size: 1.05rem; line-height: 1.6; color: #334155; margin: 0;">@Model.Description</p>
        </div>
    </div>

    <hr style="border-color: #cbd5e1; margin: 2rem 0 1.5rem 0;" />

    <div class="d-flex gap-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom">
            Edit Ticket
        </a>
        <a asp-action="Index" class="btn btn-secondary-custom">
            Back to List
        </a>
    </div>
</div>
