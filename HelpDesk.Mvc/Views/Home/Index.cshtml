@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1 class="page-title mb-2">Help Desk Dashboard</h1>
    <p class="text-muted">Real-time overview of employee support tickets and issues.</p>
</div>

<!-- Dashboard Metrics Grid -->
<div class="metrics-grid">
    <!-- Total Tickets -->
    <div class="glass-card metric-card">
        <div class="metric-info">
            <h3>Total Tickets</h3>
            <div class="value">@ViewBag.TotalTickets</div>
        </div>
        <div class="metric-icon metric-total">
            📋
        </div>
    </div>

    <!-- Open Tickets -->
    <div class="glass-card metric-card">
        <div class="metric-info">
            <h3>Open Tickets</h3>
            <div class="value">@ViewBag.OpenTickets</div>
        </div>
        <div class="metric-icon metric-open">
            🔓
        </div>
    </div>

    <!-- Closed Tickets -->
    <div class="glass-card metric-card">
        <div class="metric-info">
            <h3>Closed Tickets</h3>
            <div class="value">@ViewBag.ClosedTickets</div>
        </div>
        <div class="metric-icon metric-closed">
            🔒
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="glass-card mt-4">
    <h3 class="mb-4" style="font-weight: 600; font-size: 1.25rem;">Quick Actions</h3>
    <div class="d-flex gap-3 flex-wrap">
        <a asp-controller="Tickets" asp-action="Index" class="btn btn-primary-custom">
            View All Tickets
        </a>
        <a asp-controller="Tickets" asp-action="Create" class="btn btn-secondary-custom" style="border: 2px solid var(--accent-color); color: var(--accent-color);">
            ➕ Raise New Ticket
        </a>
    </div>
</div>

